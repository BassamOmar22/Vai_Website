# Server-only credentials. Copy to .env, which is ignored by Git.
# Never prefix RESEND_API_KEY with VITE_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=omar@vaisolutions.ai

# Set this to the public website origin in production (scheme + host, no path).
# For local Vite development:
CONTACT_ORIGIN=http://127.0.0.1:5174
PORT=3001
HOST=127.0.0.1
RESEND_FROM_EMAIL=omar@vaisolutions.ai
# Enable ONLY behind a trusted proxy that overwrites X-Forwarded-For.
CONTACT_TRUST_PROXY=false

# Optional: leave unset to use the same-origin /api/contact endpoint.
# VITE_CONTACT_ENDPOINT=/api/contact
